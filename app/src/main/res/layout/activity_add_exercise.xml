<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="25dp">


        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/primary">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_backarrow"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Add Exercise"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <View
                android:layout_width="42dp"
                android:layout_height="42dp" />

        </LinearLayout>

        <!-- Exercise Image -->

        <ImageView
            android:id="@+id/ivExercise"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_margin="16dp"
            android:scaleType="centerCrop"
            android:src="@drawable/workout_placeholder" />


        <!-- Exercise Name -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="Exercise Name"
            android:textStyle="bold"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etExerciseName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_margin="16dp"
            android:background="@drawable/edittext_background"
            android:hint="Bench Press"
            android:singleLine="true"
            android:paddingStart="14dp" />


        <!-- Sets / Reps -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sets"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etSets"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/edittext_background"
                    android:inputType="number"
                    android:hint="3"
                    android:paddingStart="14dp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reps"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etReps"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/edittext_background"
                    android:inputType="number"
                    android:hint="10"
                    android:paddingStart="14dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Equipment -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:text="Equipment"
            android:textStyle="bold"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etEquipment"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_margin="16dp"
            android:background="@drawable/edittext_background"
            android:hint="Barbell"
            android:paddingStart="14dp" />


        <!-- Instructions -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="Instructions"
            android:textStyle="bold"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etInstructions"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_margin="16dp"
            android:gravity="top"
            android:padding="14dp"
            android:background="@drawable/edittext_background"
            android:hint="Lie on the bench and press the barbell up. Keep control and breathe out."
            android:inputType="textMultiLine" />


        <!-- Completed -->

        <CheckBox
            android:id="@+id/cbCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Mark as completed" />


        <!-- Save -->

        <Button
            android:id="@+id/btnSaveExercise"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:text="Save Exercise"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/primary" />

    </LinearLayout>

</ScrollView>